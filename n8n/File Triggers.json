    {
      "parameters": {
        "jsCode": "// Normalize metadata from Google Drive, OneDrive, and Slack into one schema.\n// Output items look like:\n// {\n//   \"doc id\": \"GoogleDrive:1VIT35V0pX92BtJ5_V0jn50lEOHLkKKZr\",\n//   \"doc_name\": \"Shopify Q2 Press Release.pdf\",\n//   \"doc type\": \"pdf\",\n//   \"source\": \"GoogleDrive\",\n//   \"team\": \"\",\n//   \"created at\": \"2025-10-06T00:17:28.686Z\"\n// }\n\nconst extFromName = (name) =>\n  (typeof name === 'string' && name.includes('.'))\n    ? name.split('.').pop().toLowerCase()\n    : '';\n\nconst typeFromMime = (mime) =>\n  (typeof mime === 'string' && mime.includes('/'))\n    ? mime.split('/').pop().toLowerCase()\n    : (mime || '');\n\n// OPTIONAL fallback UUID v4 (Math.random-based; use only if you truly need random IDs)\nconst uuidv4Fallback = () =>\n  'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n\nconst detectSource = (obj) => {\n  if (obj?.kind === 'drive#file') return 'GoogleDrive';\n  if (obj?.webUrl && obj?.path && obj?.id) return 'OneDrive';\n  if (obj?.url_private_download && obj?.mimetype) return 'Slack';\n  return 'Unknown';\n};\n\nconst nativeIdFor = (source, obj) => {\n  if (source === 'GoogleDrive') return obj.id;\n  if (source === 'OneDrive')  return obj.id;\n  if (source === 'Slack')     return obj.id;\n  return obj.id || obj.name || '';\n};\n\nconst makeDocId = (source, obj) => {\n  const native = nativeIdFor(source, obj);\n  if (native) return `${source}:${native}`;\n  // If no native id exists, fall back to a UUID (prefer Web Crypto if present)\n  const rnd = (globalThis.crypto && typeof globalThis.crypto.randomUUID === 'function')\n    ? globalThis.crypto.randomUUID()\n    : uuidv4Fallback();\n  return `${source}:${rnd}`;\n};\n\nconst normalizeOne = (obj) => {\n  const source   = detectSource(obj);\n  const docName  = obj.name || obj.originalFilename || obj.title || 'unknown';\n  const docType  =\n    obj.fileExtension ||\n    obj.filetype ||\n    extFromName(docName) ||\n    typeFromMime(obj.mimeType || obj.mimetype) ||\n    'unknown';\n\n  let createdAt = null;\n  if (source === 'GoogleDrive') {\n    createdAt = obj.createdTime || obj.modifiedTime || null;\n  } else if (source === 'OneDrive') {\n    createdAt = obj.createdDateTime || obj.lastModifiedDateTime || null;\n  } else if (source === 'Slack') {\n    createdAt = obj.created\n      ? new Date(obj.created * 1000).toISOString()\n      : (obj.timestamp ? new Date(obj.timestamp * 1000).toISOString() : null);\n  }\n\n  // ✅ NEW: Determine document URL\n  let docUrl = '';\n  if (source === 'GoogleDrive') {\n    docUrl = obj.webViewLink || obj.webContentLink || '';\n  } else if (source === 'OneDrive') {\n    docUrl = obj.webUrl || '';\n  } else if (source === 'Slack') {\n    docUrl = obj.url_private_download || obj.permalink || '';\n  }\n\n  return {\n    'docId':     makeDocId(source, obj),\n    'docName':   docName,\n    'docType':   String(docType || 'unknown').toLowerCase(),\n    'source':     source,\n    'team':       $input.first().json.team, // fill downstream if you want (e.g., from path/channel/folder rules)\n    'createdAt': createdAt || new Date().toISOString(),\n    'docUrl':     docUrl || '',\n  };\n};\n\n/** @type {any[]} */\nconst out = [];\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const binary = item.binary; // preserved as-is for downstream nodes\n\n  if (Array.isArray(json)) {\n    // If your upstream node sends a list (like Drive listFiles), normalize each\n    for (const obj of json) {\n      out.push({ json: normalizeOne(obj), binary });\n    }\n  } else {\n    out.push({ json: normalizeOne(json), binary });\n  }\n}\n\nreturn out;\n"
      },
